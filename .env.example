# ==============================================================================
# NextLoad - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and configure your credentials:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB via Mongoose)
# ------------------------------------------------------------------------------
# MongoDB connection URI
DATABASE_URL=mongodb://127.0.0.1:27017/nextload

# ------------------------------------------------------------------------------
# 2. PAYLOAD CMS 3.0 CONFIGURATION
# ------------------------------------------------------------------------------
# Secret key used for signing cookies and tokens in Payload CMS (min 32 characters)
PAYLOAD_SECRET=your-random-payload-secret-key-min-32-chars

# ------------------------------------------------------------------------------
# 3. BETTER AUTH CONFIGURATION
# ------------------------------------------------------------------------------
# Secret key used for session signing in Better Auth (min 32 characters)
BETTER_AUTH_SECRET=your-random-better-auth-secret-key-min-32-chars

# Base URL of your Next.js application
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. SMTP EMAIL SERVICE (Hostinger / Custom SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM="NextLoad <support@yourdomain.com>"

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 (Optional - for Social Sign-In)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 6. CLOUDINARY CDN CONFIGURATION (Media & Avatar Uploads)
# ------------------------------------------------------------------------------
# Obtain from Cloudinary Dashboard > Settings > API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
