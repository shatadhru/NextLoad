{
  "name": "shatadhru",
  "version": "1.1.0",
  "description": "Shatadhru — built with NextLoad boilerplate",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "init:project": "node payload/scripts/init.mjs",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth-ui/core": "^1.7.26",
    "@better-auth-ui/react": "^1.7.26",
    "@delmaredigital/payload-better-auth": "^0.13.0",
    "@payloadcms/db-mongodb": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "cross-env": "^7.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.3",
    "next-cloudinary": "^6.19.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "payload": "3.90.1",
    "payload-cloudinary": "^2.3.0",
    "payload-theme": "^0.9.4",
    "postcss": "^8.5.28",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "shadcn": "^4.21.0",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "payload-theme": "patches/payload-theme.patch"
    }
  }
}
